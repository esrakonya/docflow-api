# --- DATABASE ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/docflow_db
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# --- KAFKA & REDIS ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- SECURITY ---
JWT_SECRET=change_this_to_a_long_random_base64_secret_at_least_32_bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_first_run

# --- AI PROVIDER SETTINGS ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# --- STORAGE SETTINGS ---
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=invoices

# --- STRIPE ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here
STRIPE_SUCCESS_URL=http://localhost:8080/payment/success
STRIPE_CANCEL_URL=http://localhost:8080/payment/cancel

# --- COOKIE ---
# Only set to false for local HTTP development. Must be true (or omitted) in production.
SESSION_COOKIE_SECURE=false